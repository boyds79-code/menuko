# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings → API). Create a free project at https://supabase.com if
# you don't have one yet.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose this to the browser. Used for admin actions
# like creating kitchen/cashier auth accounts. Keep this out of client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated emails allowed into /internal (the platform-operator tool
# — not restaurant-facing). Must be an email of a real Supabase Auth user
# (sign up/log in with it normally first); this only gates the /internal
# routes on top of that.
PLATFORM_ADMIN_EMAILS=you@example.com
